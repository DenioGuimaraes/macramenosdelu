RewriteEngine On

# ------------------------------------------------------------
# Front controller
# Converte o caminho da URL no parâmetro lido pelo roteador:
#   /catalogo        -> index.php?url=catalogo
#   /admin/produtos  -> index.php?url=admin/produtos
# Arquivos existentes (CSS, JS, imagens, uploads) são servidos
# diretamente, sem passar pelo PHP.
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
