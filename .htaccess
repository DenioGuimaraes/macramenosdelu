RewriteEngine On

# ------------------------------------------------------------
# Bloqueia acesso direto às pastas internas da aplicação
# (funciona tanto na raiz do domínio quanto em subpasta local)
# ------------------------------------------------------------
RewriteRule ^(app|database|docs|storage|tests|vendor)(/|$) - [F,L]
RewriteRule ^(bootstrap\.php|\.env|composer\.(json|lock))$ - [F,L]

# ------------------------------------------------------------
# Raiz do projeto
# ------------------------------------------------------------
RewriteRule ^$ public/index.php [L]

# ------------------------------------------------------------
# Demais requisições: procura o arquivo dentro de /public
# (assets reais são servidos; o restante vai ao front controller)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteRule ^(?!public/)(.*)$ public/$1 [L]
