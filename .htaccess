RewriteEngine On

# ------------------------------------------------------------
# Bloqueia acesso direto às pastas internas da aplicação
# (funciona tanto na raiz do domínio quanto em subpasta local)
# ------------------------------------------------------------
RewriteRule ^(app|database|docs|storage|tests|vendor)(/|$) - [F,L]
RewriteRule ^(bootstrap\.php|\.env|composer\.(json|lock))$ - [F,L]

# ------------------------------------------------------------
# Raiz do projeto
# ------------------------------------------------------------
RewriteRule ^$ public/index.php [L,QSA]

# ------------------------------------------------------------
# Demais requisições são resolvidas dentro de /public
# (os arquivos reais são servidos; o restante vai ao front
#  controller pelas regras de public/.htaccess)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!public/)(.*)$ public/$1 [L,QSA]
